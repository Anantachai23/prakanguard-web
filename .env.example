# =====================================================================
# PrakanGuard Environment Variables Template (.env.example)
# คัดลอกไฟล์นี้เป็น .env สำหรับรันในเครื่อง หรือตั้งค่าใน Vercel Environment Variables
# ห้ามนำไฟล์ .env ที่มีรหัสผ่านหรือ Secret Key จริงขึ้น GitHub เด็ดขาด
# =====================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_new_anon_key_here

# สำหรับ Admin Server (Node.js Backend)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=sb_publishable_your_new_anon_key_here
ADMIN_PORT=4000
