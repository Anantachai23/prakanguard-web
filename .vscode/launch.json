{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🌐 Launch Frontend Web (Edge/Chrome)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/src",
      "sourceMaps": true
    },
    {
      "name": "🛡️ Start Admin Backend Server (Node.js)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/admin/server.js",
      "cwd": "${workspaceFolder}/admin",
      "restart": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "⚡ Run Security Audit Prober",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/audit_security.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "🚀 Full-Stack (Frontend + Admin Backend)",
      "configurations": [
        "🛡️ Start Admin Backend Server (Node.js)",
        "🌐 Launch Frontend Web (Edge/Chrome)"
      ],
      "stopAll": true
    }
  ]
}
